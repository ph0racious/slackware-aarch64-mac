#  WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF
#  MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED.  IN NO
#  EVENT SHALL THE AUTHOR BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,
#  SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,
#  PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS;
#  OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
#  WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
#  OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
#  ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.

# lzfse is Apple's LZFSE compression library.  asahi-fwextract loads it to
# unpack LZFSE-compressed IMG4 payloads, which only asahi-fwupdate's rebuild of
# the ESP firmware decodes; the Wi-Fi and Bluetooth capture never needs it.
# Unlike the boot-chain packages this is ordinary C: distro CFLAGS apply and
# there is nothing Apple-specific about building it.

cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=lzfse
VERSION=${VERSION:-1.0}
BUILD=${BUILD:-1}
TAG=${TAG:-_mac}

if [ -z "$ARCH" ]; then
  ARCH=$( uname -m )
fi

if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.txz"
  exit 0
fi

if [ "$( uname -m )" != "aarch64" ]; then
  echo "$PRGNAM: builds natively on aarch64, not $( uname -m )." >&2
  exit 1
fi

NUMJOBS=${NUMJOBS:-"-j$(nproc)"}

TMP=${TMP:-/tmp/mac}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

if [ "$ARCH" = "aarch64" ]; then
  SLKCFLAGS="-O2 -fPIC"
  LIBDIRSUFFIX="64"
else
  SLKCFLAGS="-O2"
  LIBDIRSUFFIX=""
fi

# Upstream tags the tarball lzfse-1.0 and the top dir is lzfse-lzfse-1.0.
SRCNAM=lzfse-lzfse-$VERSION

set -e

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP
rm -rf $SRCNAM
tar xf $CWD/sources/$PRGNAM-$VERSION.tar.gz
cd $SRCNAM

chown -R root:root .
find . \
 \( -perm 777 -o -perm 775 -o -perm 711 -o -perm 555 -o -perm 511 \) \
 -exec chmod 755 {} \+ -o \
 \( -perm 666 -o -perm 664 -o -perm 600 -o -perm 444 -o -perm 440 -o -perm 400 \) \
 -exec chmod 644 {} \+

mkdir -p build
cd build
  cmake \
    -DCMAKE_C_FLAGS="$SLKCFLAGS" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib${LIBDIRSUFFIX} \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -Wno-dev \
    ..
  make $NUMJOBS
  make install DESTDIR=$PKG
cd ..

# Strip binaries and libraries.
find $PKG -type f \( -perm -0100 -o -name '*.so*' \) \
  -exec file {} \; 2>/dev/null | grep -E 'ELF.*(executable|shared object)' \
  | cut -f1 -d: | xargs -r strip --strip-unneeded 2>/dev/null || true

mkdir -p $PKG/usr/doc/$PRGNAM-$VERSION
cp -a LICENSE README.md $PKG/usr/doc/$PRGNAM-$VERSION 2>/dev/null || true
cat $CWD/$PRGNAM.SlackBuild > $PKG/usr/doc/$PRGNAM-$VERSION/$PRGNAM.SlackBuild

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.txz
