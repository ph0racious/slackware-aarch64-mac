#    notice, this list of conditions and the following disclaimer.
#
#  THIS SOFTWARE IS PROVIDED BY THE AUTHOR ``AS IS'' AND ANY EXPRESS OR IMPLIED
#  WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF
#  MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED.  IN NO
#  EVENT SHALL THE AUTHOR BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,
#  SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,
#  PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS;
#  OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
#  WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
#  OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
#  ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.

# WHY: asahi-audio's PipeWire filter chain is built on LSP plugins. Its configs
# reference these URIs directly:
#   http://lsp-plug.in/plugins/lv2/loud_comp_mono
#   http://lsp-plug.in/plugins/lv2/compressor_stereo
#   http://lsp-plug.in/plugins/lv2/mb_compressor_stereo
# The suite IS the DSP chain, so it cannot be skipped.
#
# NOT an Asahi package: there is no AsahiLinux PKGBUILD to port -- Arch pulls
# lsp-plugins from its own repos. This SlackBuild is written against LSP's own
# build system.
#
# BUILD SCOPE: FEATURES=lv2 only. LSP can also emit CLAP, VST2, VST3, LADSPA,
# GStreamer, standalone JACK binaries and HTML docs; we need none of them, and
# skipping them cuts a large amount of compilation.
# The source tarball is ~58 MB and bundles its own dependencies (the lsp-*
# modules), so no network access is needed during the build.
#
# LV2 path: Slackware AArch64 uses /usr/lib64, so bundles must land in
# /usr/lib64/lv2 to be discoverable. The end of this script checks that the
# three URIs above are present under that path.
#
# Run tools/fetch-sources.sh lsp-plugins-lv2 to populate sources/.

cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=lsp-plugins-lv2
SRCNAM=lsp-plugins
VERSION=${VERSION:-1.2.24}
BUILD=${BUILD:-1}
TAG=${TAG:-_mac}

if [ -z "$ARCH" ]; then
  ARCH=$( uname -m )
fi

if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.txz"
  exit 0
fi

NUMJOBS=${NUMJOBS:-"-j$(nproc)"}

TMP=${TMP:-/tmp/mac}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

if [ "$ARCH" = "aarch64" ] || [ "$ARCH" = "x86_64" ]; then
  LIBDIRSUFFIX="64"
else
  LIBDIRSUFFIX=""
fi
SLKCFLAGS="-O2 -fPIC"

set -e

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP
rm -rf $SRCNAM
tar xf $CWD/sources/$SRCNAM-src-$VERSION.tar.gz
cd $SRCNAM

chown -R root:root .
find . \( -type f -o -type d \) \
 \( \( -perm 777 -o -perm 775 -o -perm 711 -o -perm 555 -o -perm 511 \) \
 -exec chmod 755 {} \+ -o \
 \( -perm 666 -o -perm 664 -o -perm 600 -o -perm 444 -o -perm 440 -o -perm 400 \) \
 -exec chmod 644 {} \+ \)

# LSP's build is a two-step: 'make config' records the configuration, then a
# plain 'make' builds against it.
make config \
  PREFIX=/usr \
  LIBDIR=/usr/lib${LIBDIRSUFFIX} \
  SHAREDDIR=/usr/share \
  DOCDIR=/usr/doc/$PRGNAM-$VERSION \
  FEATURES=lv2 \
  CFLAGS="$SLKCFLAGS" \
  CXXFLAGS="$SLKCFLAGS"

make $NUMJOBS
make install DESTDIR=$PKG

# The whole point: LV2 bundles discoverable at the Slackware lib64 path.
if [ ! -d "$PKG/usr/lib${LIBDIRSUFFIX}/lv2" ]; then
  echo "$PRGNAM: no LV2 bundles under /usr/lib${LIBDIRSUFFIX}/lv2" >&2
  echo "  installed tree:" >&2
  find $PKG -maxdepth 4 -type d -name '*.lv2' 2>/dev/null | head -5 >&2
  exit 1
fi
n=$(find $PKG/usr/lib${LIBDIRSUFFIX}/lv2 -maxdepth 1 -name '*.lv2' | wc -l)
echo "$PRGNAM: installed $n LV2 bundles"
[ "$n" -gt 0 ] || { echo "$PRGNAM: zero bundles installed" >&2; exit 1; }

# Confirm the three plugins asahi-audio actually calls for are among them.
missing=0
for uri in loud_comp_mono compressor_stereo mb_compressor_stereo; do
  if grep -rqs "lv2/$uri" $PKG/usr/lib${LIBDIRSUFFIX}/lv2/ 2>/dev/null; then
    echo "  ok      $uri"
  else
    echo "  MISSING $uri  (asahi-audio needs it)" >&2
    missing=1
  fi
done
[ "$missing" -eq 0 ] || { echo "$PRGNAM: required plugins absent" >&2; exit 1; }

find $PKG -type f \( -perm -0100 -o -name '*.so*' \) -print0 2>/dev/null \
  | xargs -0r file 2>/dev/null | grep -E 'ELF.*(executable|shared object)' \
  | cut -f1 -d: | xargs -r strip --strip-unneeded 2>/dev/null || true

mkdir -p $PKG/usr/doc/$PRGNAM-$VERSION
cp -a COPYING* CHANGELOG README* $PKG/usr/doc/$PRGNAM-$VERSION 2>/dev/null || true
cat $CWD/$PRGNAM.SlackBuild > $PKG/usr/doc/$PRGNAM-$VERSION/$PRGNAM.SlackBuild

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.txz
